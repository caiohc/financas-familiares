# Modelo do arquivo .env: copie para .env e ajuste. O .env NÃO vai para o git (ver .gitignore).
# Documentação: docs/seguranca_docs.md (Seção 12).

# --- Banco e chave de sessão ---
DATABASE_URI=sqlite:///instance/app.db
# Gere com: uv run python -c "import secrets; print(secrets.token_hex(32))"
# Trocar a chave derruba todas as sessões abertas. Em produção precisa ter pelo menos 32 caracteres.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# --- Segurança: OBRIGATÓRIAS, sem valor padrão (a aplicação não sobe sem elas) ---
# Ambiente: development ou production.
APP_ENV=development

# Proteção de rotas: true (login obrigatório) ou false (só em development).
AUTH_ENABLED=true

# Só com AUTH_ENABLED=false: a aplicação autentica sozinha como este usuário (precisa existir, estar ativo e ter senha).
# Trocar o usuário aqui é a forma de ver as telas como administrador do sistema, de família ou usuário comum.
#DEV_AUTO_LOGIN_USERNAME=seu.usuario

# --- Opcionais ---
# Depurador do Flask. Fica desligado por padrão; não ligue em produção.
FLASK_DEBUG=false

# Mostra todo o SQL no terminal (útil para depurar consultas). Fica separado do FLASK_DEBUG de propósito:
# ligado junto, enterrava as mensagens dos comandos de CLI.
SQL_ECHO=false

# Endereço público usado nos links enviados por e-mail. OBRIGATÓRIO em produção (https://...).
# Sem ele (só em desenvolvimento), os links usam o cabeçalho Host da requisição.
#APP_BASE_URL=https://financas.exemplo.com

# log = escreve a mensagem (com o link do convite) no log do servidor; só para desenvolvimento.
# smtp = ainda não implementado (produção não sobe até que seja).
EMAIL_BACKEND=log

# Cookie de sessão só por HTTPS. Obrigatório (true) em produção.
SESSION_COOKIE_SECURE=false
